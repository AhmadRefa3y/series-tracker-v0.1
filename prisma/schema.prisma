datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String           @id @default(uuid()) // Changed to uuid()
  name           String           @default("NO_NAME")
  email          String           @unique // Removed map
  password       String?
  role           String           @default("user")
  emailVerified  DateTime?
  image          String?
  paymentMethod  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  account        Account[]
  session        Session[]
  series         Series[]
  WatchedEpisode WatchedEpisode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) // <-- Add this line
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Removed onUpdate
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Series {
  id              String           @id @unique @default(cuid())
  title           String
  posterPath      String?
  createdAt       DateTime         @default(now())
  watchedEpisodes WatchedEpisode[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  seriesTmdbId    String
  latestWatchedAt DateTime         @default(now())

  @@unique([seriesTmdbId, userId])
}

model WatchedEpisode {
  id            String   @id @default(cuid())
  seasonNumber  Int
  episodeNumber Int
  watchedAt     DateTime @default(now())
  Series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId      String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  @@unique([seriesId, seasonNumber, episodeNumber, userId])
}
